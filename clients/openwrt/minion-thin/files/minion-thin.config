config minion-thin 'main'
	option enabled '0'
	# The Hub address, e.g. https://minion.example.com
	option hub ''
	# Shown in the Hub; empty = the hostname
	option name ''
	# One-time invitation key (mnk_...). It is moved into the state directory at the next start and removed
	# from this file; the Worker erases it after a successful enrollment.
	option invite ''
	# Enrollment state (identity key, Hub pin): keep it on flash; it survives sysupgrade.
	option state_dir '/etc/minion-thin'
	option cols '80'
	option rows '24'
	option scrollback '16384'
	# Sessions: NAME=COMMAND (run by /bin/sh -c)
	list session 'shell=exec /bin/ash -l'
