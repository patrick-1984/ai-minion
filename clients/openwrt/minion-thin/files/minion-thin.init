#!/bin/sh /etc/rc.common
# Minion thin Worker (procd). Configure in /etc/config/minion-thin, then: /etc/init.d/minion-thin enable start

START=99
USE_PROCD=1
PROG=/usr/sbin/minion-thin

add_session() {
	procd_append_param command --session "$1"
}

start_service() {
	local enabled hub name invite state_dir cols rows scrollback
	config_load minion-thin
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get hub main hub
	[ -n "$hub" ] || {
		echo "minion-thin: set option hub" >&2
		return 1
	}
	config_get name main name
	config_get invite main invite
	config_get state_dir main state_dir /etc/minion-thin
	config_get cols main cols 80
	config_get rows main rows 24
	config_get scrollback main scrollback 16384

	mkdir -p "$state_dir" && chmod 700 "$state_dir"
	if [ -n "$invite" ]; then
		# hand the one-time key to the Worker through its private state directory, never on the command line
		umask 077
		printf '%s' "$invite" > "$state_dir/invite"
		uci -q delete minion-thin.main.invite && uci -q commit minion-thin
	fi

	procd_open_instance
	procd_set_param command "$PROG" --hub "$hub" --state-dir "$state_dir" --cols "$cols" --rows "$rows" \
		--scrollback "$scrollback"
	[ -n "$name" ] && procd_append_param command --name "$name"
	config_list_foreach main session add_session
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger minion-thin
}
