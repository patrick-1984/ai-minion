          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageBucketListResult"
                }
              }
            },
            "description": "Authorized usage result"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HubError"
                }
              }
            },
            "description": "Hub API error"
          }
        },
        "summary": "List your private usage buckets."
      }
    },
