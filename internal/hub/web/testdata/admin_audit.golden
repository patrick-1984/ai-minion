<main id="content" tabindex="-1">

<div class="page-head"><div><h1>Audit</h1><p>Who did what and when. Events never contain secrets or terminal content.</p></div></div>
<form method="get" action="/admin/audit" class="toolbar" aria-label="Filter the audit log">
  <div class="field">
    <label for="f-actor">Actor (user id, or key:id)</label>
    <input type="text" id="f-actor" name="actor" value="abc" autocomplete="off" spellcheck="false" maxlength="256" placeholder="e.g. key:example">
  </div>
  <div class="field">
    <label for="f-action">Action (for example settings.set)</label>
    <input type="text" id="f-action" name="action" value="settings.set" autocomplete="off" spellcheck="false" maxlength="256">
  </div>
  <div class="field">
    <label for="f-from">From (date or time, UTC)</label>
    
    <input type="date" id="f-from" name="from" value="" autocomplete="off" placeholder="e.g. 2026-11-01">
    <button type="button" class="btn btn-secondary btn-sm" data-audit-time="#f-from">Enter a date or RFC 3339 time</button>
  </div>
  <div class="field">
    <label for="f-to">To (date or time, UTC)</label>
    
    <input type="date" id="f-to" name="to" value="" autocomplete="off" placeholder="e.g. 2026-11-09">
    <button type="button" class="btn btn-secondary btn-sm" data-audit-time="#f-to">Enter a date or RFC 3339 time</button>
  </div>
  <div class="field">
    <label for="f-limit">Events per page</label>
    <select id="f-limit" name="limit">
      <option value="25">25</option>
      <option value="50" selected>50</option>
      <option value="100">100</option>
      <option value="200">200</option>
      
    </select>
  </div>
  <div class="row"><button type="submit">Filter</button>
  <a class="btn btn-secondary" href="/admin/audit">Clear</a></div>
</form>

<p class="muted">Sorting applies to the rows on this page.</p>
<div class="table-wrap"><table data-sortable>
  <caption class="muted">Initially newest first. Times are UTC. Events never contain secrets or terminal content.</caption>
  <thead><tr><th scope="col" data-sort="text">Time</th><th scope="col" data-sort="text">Actor</th><th scope="col" data-sort="text">Acting as</th><th scope="col" data-sort="text">Action</th><th scope="col" data-sort="text">Target</th><th scope="col" data-sort="text">Outcome</th><th scope="col" data-sort="text">Detail</th></tr></thead>
  <tbody>
  <tr>
    <td><time datetime="2026-11-09T12:00:05.000Z">2026-11-09 12:00:05</time></td>
    <td class="cell-clamp" title="0190a1b2-c3d4-7e5f-8a6b-000000000001" tabindex="0">0190a1b2-c3d4-7e5f-8a6b-000000000001</td>
    <td class="cell-clamp" title="" tabindex="0"><span class="muted">-</span></td>
    <td class="cell-clamp" title="settings.set" tabindex="0">settings.set</td>
    <td class="cell-clamp" title="public_url" tabindex="0">public_url</td>
    <td>ok</td>
    <td class="cell-clamp" title=" " tabindex="0"><span class="muted">-</span></td>
  </tr>
  <tr>
    <td><time datetime="2026-11-09T11:00:00.000Z">2026-11-09 11:00:00</time></td>
    <td class="cell-clamp" title="0190a1b2-c3d4-7e5f-8a6b-000000000001" tabindex="0">0190a1b2-c3d4-7e5f-8a6b-000000000001</td>
    <td class="cell-clamp" title="0190a1b2-c3d4-7e5f-8a6b-000000000002" tabindex="0">0190a1b2-c3d4-7e5f-8a6b-000000000002</td>
    <td class="cell-clamp" title="worker.delete" tabindex="0">worker.delete</td>
    <td class="cell-clamp" title="w1" tabindex="0">w1</td>
    <td>success</td>
    <td class="cell-clamp" title=" " tabindex="0"><span class="muted">-</span></td>
  </tr>
  <tr>
    <td><time datetime="2026-11-08T09:00:00.000Z">2026-11-08 09:00:00</time></td>
    <td class="cell-clamp" title="anonymous" tabindex="0">anonymous</td>
    <td class="cell-clamp" title="" tabindex="0"><span class="muted">-</span></td>
    <td class="cell-clamp" title="auth.login" tabindex="0">auth.login</td>
    <td class="cell-clamp" title="" tabindex="0"><span class="muted">-</span></td>
    <td>failed</td>
    <td class="cell-clamp" title=" " tabindex="0"><span class="muted">-</span></td>
  </tr>
  
  </tbody>
</table></div>
<p>
  
  <a href="/admin/audit?action=settings.set&amp;actor=abc&amp;cursor=CUR2" rel="next">Older events</a>
</p>

    </main>