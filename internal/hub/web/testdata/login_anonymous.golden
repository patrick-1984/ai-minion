<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in - Minion</title>
<meta name="htmx-config" content='{"includeIndicatorStyles":false}'>
<meta name="color-scheme" content="light dark">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<script src="/static/theme.js"></script>
<link rel="stylesheet" href="/static/minion.css">
<script src="/static/htmx.min.js" defer></script>
<script src="/static/sse.js" defer></script>
<script src="/static/forms.js" defer></script>
<script src="/static/shell.js" defer></script>
<script src="/static/ui-extras.js" defer></script>
</head>
<body hx-ext="sse">
<a class="skip-link" href="#content" data-modal-inert>Skip to content</a>


<header class="topbar anon">
  <a class="brand" href="/"><svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><mask id="mn-cut"><rect width="32" height="32" fill="#fff"/><path d="M10 3L16 11.2L22 3Z" fill="#000"/><circle cx="16" cy="17" r="3.3" fill="#000"/><path d="M13.8 21.4L9 16.9M18.2 21.4L23 16.9" stroke="#000" stroke-width="2" stroke-linecap="round" fill="none"/><path d="M13.3 21H18.7Q19.6 22.6 19.6 24.6V31H12.4V24.6Q12.4 22.6 13.3 21Z" fill="#000"/></mask><rect x="2" y="4.5" width="28" height="24.9" rx="2" fill="#10b981" mask="url(#mn-cut)"/></svg><span>Minion</span></a>
</header>
<div id="banner-slot"></div>
<div id="flash-area" aria-live="polite"></div>
<main id="content" tabindex="-1">

<section class="card auth-card">
  <h1>Sign in</h1>
  <form method="post" action="/auth/login" data-json-action="/auth/login" data-next="/">
    <p class="form-error" role="alert" data-form-error hidden></p>
    <div class="field">
      <label for="username">Username or e-mail</label>
      <input type="text" id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus placeholder="e.g. jordan">
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
    </div>
    <button type="submit"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-login"/></svg><span>Sign in</span></button>
  </form>
  
  <noscript><p class="muted">Signing in needs JavaScript in this browser.</p></noscript>
</section>

</main>

</body>
</html>

